                            "        pm.expect(emp).to.have.property('avgCompletionHours');",
                            "        console.log('  ' + emp.employeeName + ': assigned=' + emp.tasksAssigned + ', completed=' + emp.tasksCompleted + ', onTime=' + emp.onTimeRate + '%');",
                            "    });",
                            "",
                            "    console.log('Total employees: ' + json.data.length);",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "━━━ REPORT EXPORT ENDPOINTS ━━━",
            "item": [],
            "description": "Async report export and download endpoints. Export triggers a background CSV generation. Download validates 24-hour expiry."
        },
        {
            "name": "7. Export Task Summary Report",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"reportType\": \"TASK_SUMMARY\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/analytics/reports/export",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "analytics",
                        "reports",
                        "export"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Task Summary report export initiated', function () {",
                            "    pm.response.to.have.status(200);",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.success).to.be.true;",
                            "    var d = json.data;",
                            "    pm.expect(d).to.have.property('reportId');",
                            "    pm.expect(d).to.have.property('downloadUrl');",
                            "    pm.expect(d).to.have.property('message');",
                            "",
                            "    pm.collectionVariables.set('reportId', d.reportId);",
                            "    console.log('Report ID: ' + d.reportId);",
                            "    console.log('Download URL: ' + d.downloadUrl);",
                            "});"
                        ]
                    }
                }
            ]
        },
