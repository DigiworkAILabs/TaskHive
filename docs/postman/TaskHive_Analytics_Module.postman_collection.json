                            "    // Or it may return 400/500 depending on validation timing",
                            "    var status = pm.response.code;",
                            "    console.log('Response status: ' + status);",
                            "    console.log('Response: ' + pm.response.text().substring(0, 300));",
                            "});"
                        ]
                    }
                }
            ]
        },
