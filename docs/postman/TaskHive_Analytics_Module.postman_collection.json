{
    "info": {
        "name": "TaskHive - Analytics Module",
        "description": "Complete testing collection for the Analytics module (Phase 6).\n\n**Pre-requisites:**\n1. Auth, Employee, and Task modules must be set up.\n2. Tasks must exist in the database (with various statuses and assignments).\n3. The MetricsCalculationScheduler runs nightly at 2 AM — for immediate dashboard data, the fallback real-time queries will be used.\n\n**Flow:** Login as Admin → Admin Dashboard → Employee Dashboard → Task Distribution → Priority Distribution → Completion Trend → Employee Performance → Export Report → Download Report\n\n**Error Testing:** Invalid report type, expired download, non-existent report\n\n**Auth:** Cookie-based (set automatically on login). No manual token needed.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080/api/v1"
        },
        {
            "key": "reportId",
            "value": "",
            "description": "ID of the exported report (set automatically by export test)"
        }
    ],
    "item": [
        {
            "name": "━━━ SETUP: Login ━━━",
            "item": [],
            "description": "Login as Admin to access analytics endpoints. All analytics endpoints except Employee Dashboard require ADMIN role."
        },
        {
            "name": "0. Login as Admin",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"email\": \"admin@taskhive.com\",\n    \"password\": \"Admin@123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "auth",
                        "login"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Admin login successful', function () {",
                            "    pm.response.to.have.status(200);",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.success).to.be.true;",
                            "    console.log('Admin logged in. Cookies set automatically.');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "━━━ DASHBOARD ENDPOINTS ━━━",
            "item": [],
            "description": "Admin and Employee dashboard endpoints. Admin dashboard reads from pre-calculated daily_metrics table (populated by nightly scheduler). If no metrics exist yet, zeroes are returned."
        },
        {
            "name": "1. Admin Dashboard",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/analytics/dashboard/admin",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "analytics",
                        "dashboard",
                        "admin"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Admin dashboard retrieved successfully', function () {",
                            "    pm.response.to.have.status(200);",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.success).to.be.true;",
                            "    var d = json.data;",
                            "    pm.expect(d).to.have.property('totalTasks');",
                            "    pm.expect(d).to.have.property('activeTasks');",
                            "    pm.expect(d).to.have.property('overdueTasks');",
                            "    pm.expect(d).to.have.property('completedTasks');",
                            "    pm.expect(d).to.have.property('completionRate');",
                            "    pm.expect(d).to.have.property('totalEmployees');",
                            "    pm.expect(d).to.have.property('avgCompletionHours');",
                            "    pm.expect(d).to.have.property('metricDate');",
                            "",
                            "    console.log('Dashboard: total=' + d.totalTasks + ', active=' + d.activeTasks + ', overdue=' + d.overdueTasks + ', completed=' + d.completedTasks);",
                            "    console.log('Rate: ' + d.completionRate + '%, Avg Hours: ' + d.avgCompletionHours + ', Employees: ' + d.totalEmployees);",
                            "    console.log('Metric Date: ' + d.metricDate);",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "2. Employee Dashboard (as Admin)",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/analytics/dashboard/employee",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "analytics",
                        "dashboard",
                        "employee"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Employee dashboard retrieved successfully', function () {",
                            "    pm.response.to.have.status(200);",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.success).to.be.true;",
                            "    var d = json.data;",
                            "    pm.expect(d).to.have.property('totalTasks');",
                            "    pm.expect(d).to.have.property('todoTasks');",
                            "    pm.expect(d).to.have.property('inProgressTasks');",
                            "    pm.expect(d).to.have.property('inReviewTasks');",
                            "    pm.expect(d).to.have.property('completedTasks');",
                            "    pm.expect(d).to.have.property('onTimeCompletionRate');",
                            "    pm.expect(d).to.have.property('avgCompletionHours');",
                            "",
                            "    console.log('Employee: total=' + d.totalTasks + ', todo=' + d.todoTasks + ', inProgress=' + d.inProgressTasks + ', done=' + d.completedTasks);",
                            "    console.log('On-time rate: ' + d.onTimeCompletionRate + '%, Avg Hours: ' + d.avgCompletionHours);",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "━━━ CHART ENDPOINTS ━━━",
            "item": [],
            "description": "Chart data endpoints for task distribution (pie/donut charts), priority breakdown, completion trend (line chart), and employee performance table."
        },
        {
            "name": "3. Task Distribution by Status",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/analytics/tasks/distribution",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "analytics",
                        "tasks",
                        "distribution"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Task distribution by status retrieved', function () {",
                            "    pm.response.to.have.status(200);",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.success).to.be.true;",
                            "    pm.expect(json.data).to.be.an('array');",
                            "",
                            "    json.data.forEach(function(item) {",
                            "        pm.expect(item).to.have.property('status');",
                            "        pm.expect(item).to.have.property('count');",
                            "        pm.expect(item.count).to.be.a('number');",
                            "        console.log('  ' + item.status + ': ' + item.count);",
                            "    });",
                            "",
                            "    console.log('Total statuses: ' + json.data.length);",
                            "});"
                        ]
                    }
                }
            ]
        },
