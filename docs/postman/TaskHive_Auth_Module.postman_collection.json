        {
            "name": "4. Get Current User (/me)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/auth/me",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "auth",
                        "me"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Get current user returns 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.success).to.be.true;",
                            "    pm.expect(json.data).to.have.property('id');",
                            "    pm.expect(json.data).to.have.property('email');",
                            "    pm.expect(json.data).to.have.property('firstName');",
                            "    pm.expect(json.data).to.have.property('role');",
                            "    pm.expect(json.data.status).to.eql('ACTIVE');",
                            "    console.log('Current user: ' + json.data.email + ' (' + json.data.role + ')');",
                            "});"
                        ]
                    }
                }
            ]
        },
