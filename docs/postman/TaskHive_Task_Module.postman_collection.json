{
    "info": {
        "name": "TaskHive - Task Module",
        "description": "Complete testing collection for the Task module (Phase 3).\n\n**Pre-requisites:**\n1. Employee module must be set up (at least one ACTIVE employee exists).\n2. Login as Admin first (Step 0).\n\n**Flow:** Login → Create Task → List → Search → Get → Update → Status Transitions → Comments → Attachments → History → My Tasks (Employee) → Overdue → Delete\n\n**Note:** Steps 16-18 require logging in as an Employee. Use the employee's credentials (email + password set during account activation).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080/api/v1"
        },
        {
            "key": "taskId",
            "value": ""
        },
        {
            "key": "employeeId",
            "value": "",
            "description": "ID of an ACTIVE employee to assign tasks to"
        },
        {
            "key": "commentId",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "━━━ ADMIN FLOW ━━━",
            "item": [],
            "description": "All requests below require Admin login"
        },
        {
            "name": "0. Login as Admin",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"email\": \"admin@taskhive.com\",\n    \"password\": \"Admin@123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "auth",
                        "login"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Admin login successful', function () {",
                            "    pm.response.to.have.status(200);",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.success).to.be.true;",
                            "    console.log('Admin logged in. Cookies set automatically.');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "1. List Employees (to get employeeId)",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/employees?status=ACTIVE&page=0&size=5",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "employees"
                    ],
                    "query": [
                        {
                            "key": "status",
                            "value": "ACTIVE"
                        },
                        {
                            "key": "page",
                            "value": "0"
                        },
                        {
                            "key": "size",
                            "value": "5"
                        }
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Active employees found', function () {",
                            "    pm.response.to.have.status(200);",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.success).to.be.true;",
                            "    pm.expect(json.data.content.length).to.be.above(0);",
                            "    var empId = json.data.content[0].id;",
                            "    pm.collectionVariables.set('employeeId', empId);",
                            "    console.log('Using employee: ' + json.data.content[0].firstName + ' ' + json.data.content[0].lastName + ' (ID: ' + empId + ')');",
                            "});"
                        ]
                    }
                }
            ]
        },
