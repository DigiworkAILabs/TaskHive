                    "raw": "{\n    \"title\": \"Implement User Dashboard\",\n    \"description\": \"Design and implement the main user dashboard with analytics widgets, recent activity feed, and quick action buttons.\",\n    \"priority\": \"HIGH\",\n    \"dueDate\": \"2026-03-15T17:00:00\",\n    \"assignedTo\": \"{{employeeId}}\",\n    \"estimatedHours\": 24.5,\n    \"tags\": [\"frontend\", \"dashboard\", \"sprint-7\"]\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/tasks",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "tasks"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Task created (201)', function () {",
                            "    pm.response.to.have.status(201);",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.success).to.be.true;",
                            "    pm.expect(json.data).to.have.property('id');",
                            "    pm.expect(json.data.status).to.eql('TODO');",
                            "    pm.expect(json.data.priority).to.eql('HIGH');",
                            "    pm.expect(json.data.title).to.eql('Implement User Dashboard');",
                            "    pm.expect(json.data.tags).to.include('frontend');",
                            "",
                            "    pm.collectionVariables.set('taskId', json.data.id);",
                            "    console.log('Task ID saved: ' + json.data.id);",
                            "});"
                        ]
                    }
                }
            ]
        },
